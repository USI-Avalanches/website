---
interface Props {
  callToAction?: string;
}

const { callToAction } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = [
  [{
      type: 'heading',
      text: 'Kontakt'
    }, {
      type: 'link',
      text: "info@usi-avalanches.at",
      link: 'mailto:info@usi-avalanches.at',
    }, {
      type: 'link',
      text: "Instagram",
      link: 'https://www.instagram.com/usi_avalanches_ff',
    }, {
      type: 'link',
      text: "Facebook",
      link: 'https://www.facebook.com/usiavalanchesff',
    }, {
      type: 'link',
      text: "Newsletter",
      link: 'https://eepurl.com/gpkvIn',
    }],
  [{
      type: 'heading',
      text: 'Links'
    }, {
      type: 'link',
      text: "Impressum",
      link: `${base}impressum`,
    }, {
      type: 'link',
      text: "Datenschutzerklärung",
      link: `${base}datenschutz`,
    }, {
      type: 'link',
      text: "Team Shop",
      link: 'https://usi-avalanches.myspreadshop.at/'
    }],
];
---

<footer
  class="snap-end container mx-auto mt-8 pb-12 md:pb-4"
>
  <div class="">
    <section class="grid grid-cols-1 md:grid-cols-2 pt-10 md:pt-0">
      {
        content.map((section) => (
          <div class="px-6 py-2 md:py-12 text-center">
            {section.map((item) => {
              if (item.type === 'heading') {
                return <h2 class="footer-heading text-2xl text-white">{item.text}</h2>
              } else if (item.type==='link') {
                return <a class="footer-link" href={item.link}><p class="text-white">{item.text}</p></a>
            } else {
              return null
            }})}
          </div>
        ))
      }
    </div>
  </div>
</footer>


<style>
  .footer-link + .footer-heading {
    margin-top: 1rem;
  }

</style>
