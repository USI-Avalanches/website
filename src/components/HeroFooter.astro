---
interface Props {
  callToAction?: string;
}

const { callToAction } = Astro.props;
const base = import.meta.env.BASE_URL;
const content = [
  [{
      type: 'heading',
      text: 'Kontakt'
    }, {
      type: 'link',
      text: "info@usi-avalanches.at",
      link: 'mailto:info@usi-avalanches.at',
    }, {
      type: 'link',
      text: "Instagram",
      link: 'https://www.instagram.com/usi_avalanches/',
    }, {
      type: 'link',
      text: "Facebook",
      link: 'https://www.facebook.com/USIAvalanches/',
    }, {
      type: 'button',
      text: "Newsletter abonnieren",
      link: 'https://eepurl.com/gpkvIn',
    }],
  [{
      type: 'heading',
      text: 'Links'
    }, {
      type: 'link',
      text: "Impressum",
      link: `${base}impressum`,
    }, {
      type: 'link',
      text: "Datenschutzerklärung",
      link: `${base}datenschutz`,
    }, {
      type: 'link',
      text: "Team Shop",
      link: 'https://www.usi-avalanches.at/team-shop/'
    }],
];
---

<footer
  class="snap-end container bg-background/90 backdrop-blur-sm mx-auto mt-48 rounded-t-3xl pb-12 md:pb-4"
>
  <div class="">
    <section class="grid grid-cols-1 md:grid-cols-3 pt-10 md:pt-0">
      {
        content.map((section) => (
          <div class="px-12 py-2 md:py-12 text-center">
            {section.map((item) => {
              if (item.type === 'heading') {
                return <h1 class="footer-heading uppercase text-2xl italic text-white">{item.text}</h1>
              } else if (item.type==='link') {
                return <a class="footer-link" href={item.link}><p class="text-white">{item.text}</p></a>
              } else if (item.type === 'button') {
                return <a class="button newsletter-button" href={item.link} target="_blank" rel="noreferrer">{item.text}</a>
            } else {
              return null
            }})}
          </div>
        ))
      }
      <div class="p-4 col-span-1 flex justify-center content-center items-center" >
      <img src={`${base}images/avalanche-logo.png`} alt="USI Avalanches" class="max-h-28 md:max-h-48 w-auto" />
    </div>
    </div>
  </div>
</footer>


<style>
  .footer-link + .footer-heading {
    margin-top: 1rem;
  }

  .newsletter-button { margin-top: .5rem; font-size: .72rem; }
</style>
