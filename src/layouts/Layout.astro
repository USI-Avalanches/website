---
import { SEO } from 'astro-seo';
import { ViewTransitions } from 'astro:transitions';

interface Props { title?: string; seoTitle?: string; }
const { title = 'USI Avalanches', seoTitle } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="USI Avalanches: Flag Football in Innsbruck. Lerne unser Team und den kontaktlosen Footballsport kennen." />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/png" href={`${base}images/avalanche-logo.png`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
		<link rel="stylesheet" href={`${base}fonts/costa-rica.css`} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#101923" />
		<SEO title={seoTitle ?? title} description="USI Avalanches: Flag Football in Innsbruck." titleDefault="USI Avalanches" titleTemplate="%s | USI Avalanches" openGraph={{ basic: { title: seoTitle ?? title, type: 'website', image: new URL(`${base}images/avalanche-social-logo.png`, Astro.site).toString() }, optional: { locale: 'de_AT' } }} />
		<ViewTransitions />
	</head>
	<body class="flex-col flex min-h-screen bg-background"><slot /></body>
</html>

<style is:global>
	:root { color-scheme: dark; --ice: #76a8d3; --red: #dc222d; }
	h1, h2, h3, .bigFont { font-family: 'Costa Rica', sans-serif; font-weight: 800; }
	p { font-family: 'Inter', sans-serif; font-weight: 400; }
	body { color: #f7f9fb; background: #101923; }
	.site-shell { min-height: 100vh; background-color: #101923; background-image: linear-gradient(180deg, rgb(16 25 35 / 18%) 0%, rgb(16 25 35 / 48%) 24%, rgb(16 25 35 / 88%) 58%, #101923 82%, #101923 100%), var(--stone-image); background-position: center top; background-size: 100% 60vw, 100% auto; background-repeat: no-repeat; }
	.site-header { max-width: 1200px; margin: 0 auto; padding: 1.2rem 1.5rem; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
	.site-header { position: relative; }
	.brand img { width: 92px; height: 70px; object-fit: contain; }
	.site-header nav { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: clamp(.8rem, 2vw, 2rem); }
	.site-header nav a { color: #f7f9fb; font: 600 .85rem Inter, sans-serif; text-decoration: none; text-transform: uppercase; letter-spacing: .08em; }
	.site-header nav a:hover { color: var(--ice); }
	.menu-toggle { display: none; align-items: center; gap: .65rem; border: 1px solid #ffffff38; border-radius: .4rem; padding: .65rem .8rem; background: #101923e8; color: #f7f9fb; font: 600 .75rem Inter, sans-serif; text-transform: uppercase; letter-spacing: .08em; }
	.menu-icon { display: grid; gap: 4px; width: 18px; }
	.menu-icon span { width: 18px; height: 2px; border-radius: 2px; background: currentColor; }
	.partner-footer { max-width: 1200px; margin: 2rem auto 0; padding: 2rem 1.5rem 3rem; border-top: 1px solid #ffffff20; text-align: center; }
	.partner-footer h2 { margin: 0 0 1.5rem; color: #d8e0e8; font-size: 1.45rem; }
	.photo-credit { margin: 1rem 0 0; color: #aebdca; font: 400 .8rem/1.5 Inter, sans-serif; }
	.photo-credit a { color: #d8e0e8; text-decoration: underline; text-underline-offset: .2em; }
	.photo-credit a:hover { color: var(--ice); }
	.partner-logos { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: center; justify-items: center; gap: 1.5rem; }
	.partner-logos a { display: grid; place-items: center; width: 100%; min-width: 0; height: 96px; padding: 1rem 1.25rem; border: 1px solid #ffffff90; border-radius: .55rem; background: #fff; box-shadow: 0 8px 22px #0004; transition: transform .2s ease, box-shadow .2s ease; }
	.partner-logos a:hover { transform: translateY(-3px); box-shadow: 0 12px 28px #0006; }
	.partner-logos a:focus-visible { outline: 3px solid var(--ice); outline-offset: 4px; }
	.partner-logos img { max-width: min(100%, 210px); max-height: 64px; width: auto; height: auto; object-fit: contain; }
	.partner-logos a:first-child img { max-width: min(100%, 190px); }
	.page-content { max-width: 1200px; min-height: 45vh; margin: 0 auto; padding: 2rem 1.5rem 2rem; }
	.page-content-home { max-width: none; padding: 0; }
	.hero { min-height: min(700px, 78vh); max-width: 1200px; margin: 0 auto; padding: 8vh 1.5rem 5rem; display: flex; align-items: center; }
	.hero-copy { max-width: 720px; }
	.eyebrow { color: var(--ice); font: 700 .8rem Inter, sans-serif; letter-spacing: .2em; text-transform: uppercase; }
	.hero h1 { margin: .5rem 0 1rem; font-size: clamp(4rem, 12vw, 9rem); line-height: .82; text-transform: uppercase; text-shadow: 0 5px 25px #0009; }
	.hero h1 span { display: block; color: var(--ice); }
	.hero p { max-width: 560px; font-size: clamp(1rem, 2vw, 1.2rem); line-height: 1.7; color: #e0e8f0; }
	.button { display: inline-flex; margin-top: 1rem; padding: .9rem 1.25rem; background: var(--ice); color: #101923; border-radius: .35rem; text-decoration: none; font: 700 .85rem Inter, sans-serif; letter-spacing: .08em; text-transform: uppercase; }
	.home-section { padding: 4rem max(1.5rem, calc((100vw - 1200px)/2)); }
	.home-section h2 { margin: 0 0 1rem; font-size: clamp(2.5rem, 6vw, 4.5rem); text-transform: uppercase; }
	.home-grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; gap: 3rem; }
	.team-photo { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: .5rem; box-shadow: 0 20px 50px #0007; }
	.tile-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
	.home-tile { position: relative; isolation: isolate; display: flex; min-width: 0; aspect-ratio: 16 / 9; min-height: 180px; align-items: flex-end; overflow: hidden; border: 1px solid #ffffff30; border-radius: .5rem; color: white; text-decoration: none; }
	.home-tile img, .tile-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
	.home-tile img { z-index: -1; object-fit: cover; }
	.tile-shade { z-index: 0; background: linear-gradient(0deg,#081321e8,transparent 80%); }
	.home-tile h3 { position: relative; z-index: 1; margin: 0; padding: 1.4rem; font-size: 2rem; text-transform: uppercase; }
	@media (max-width: 700px) {
		.site-header { align-items: center; padding: .8rem 1rem; }
		.brand img { width: 66px; height: 54px; }
		.menu-toggle { display: inline-flex; }
		.site-header nav { display: none; position: absolute; z-index: 10; top: calc(100% - .3rem); right: 1rem; min-width: 190px; padding: .65rem; flex-direction: column; gap: 0; border: 1px solid #ffffff24; border-radius: .5rem; background: #101923f5; box-shadow: 0 12px 32px #0008; }
		.site-header nav.is-open { display: flex; }
		.site-header nav a { padding: .85rem .75rem; font-size: .76rem; }
		.hero { min-height: 65vh; padding-top: 5rem; }
		.home-grid, .tile-grid { grid-template-columns: 1fr; }
		.home-section { padding-top: 3rem; padding-bottom: 3rem; }
		.partner-footer { padding-top: 1.5rem; }
		.partner-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
		.partner-logos a { height: 76px; padding: .65rem .75rem; }
		.partner-logos img, .partner-logos a:first-child img { max-width: min(100%, 155px); max-height: 50px; }
	}
	@media (min-width: 701px) and (max-width: 900px) {
		.tile-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.home-tile:last-child { grid-column: 1 / -1; justify-self: center; width: calc((100% - 1rem) / 2); }
		.partner-logos { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 640px; margin: 0 auto; }
	}
</style>
