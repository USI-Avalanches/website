---
import IndexLayout from '../layouts/IndexLayout.astro';
const base = import.meta.env.BASE_URL;
---

<IndexLayout title="USI Avalanches">
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Flag Football · Innsbruck</p>
			<h1>USI <span>Avalanches</span></h1>
			<p>Teamgeist, Tempo und Tiroler Football. Wir sind das Flag-Football-Team der USI Innsbruck – offen für alle, die den Sport kennenlernen und gemeinsam spielen wollen.</p>
			<a class="button" href={`${base}wer-wir-sind`}>Lerne das Team kennen</a>
		</div>
	</section>

	<section class="home-section home-grid">
		<div>
			<p class="eyebrow">Seit 2007 in Bewegung</p>
			<h2>Mehr als nur ein Spiel.</h2>
			<p>Aus einem USI-Sportkurs wurde ein Team mit Tiroler Wurzeln und Erfolgen in ganz Österreich. Heute trainieren Studierende und Berufstätige gemeinsam – und freuen uns immer über neue Gesichter.</p>
			<a class="button" href={`${base}wer-wir-sind`}>Unsere Geschichte</a>
		</div>
		<img class="team-photo" src={`${base}images/team-huddle-2024.jpg`} alt="Die USI Avalanches im Teamhuddle auf dem Innsbrucker USI-Sportplatz" loading="lazy" />
	</section>

	<section class="home-section">
		<p class="eyebrow">Entdecke die Avalanches</p>
		<h2>Mitspielen. Mitfiebern. Dabeisein.</h2>
		<div class="tile-grid">
			<a class="home-tile" href={`${base}was-ist-flagfootball`}>
				<img src={`${base}images/flag-action-2024.jpeg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Was ist Flag Football?</h3>
			</a>
			<a class="home-tile" href={`${base}wer-wir-sind`}>
				<img src={`${base}images/team-photo-2023.jpeg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Unser Team</h3>
			</a>
			<a class="home-tile" href={`${base}kontakt`}>
				<img src={`${base}images/flag-action-2022.jpg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Probetraining anfragen</h3>
			</a>
		</div>
	</section>
</IndexLayout>
