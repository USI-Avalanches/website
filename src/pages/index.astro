---
import IndexLayout from '../layouts/IndexLayout.astro';
import InstagramEmbed from '../components/InstagramEmbed.astro';
const base = import.meta.env.BASE_URL;
---

<IndexLayout title="USI Avalanches">
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Flag Football · Innsbruck</p>
			<h1>USI <span>Avalanches</span></h1>
			<p>Wir sind die USI Avalanches aus Innsbruck und spielen Flag Football. Du willst es selbst ausprobieren? Komm zum Training und lern uns kennen.</p>
			<a class="button" href={`${base}wer-wir-sind`}>Lerne das Team kennen</a>
		</div>
	</section>

	<section class="home-section home-grid">
		<div>
			<p class="eyebrow">Seit 2007 in Innsbruck</p>
			<h2>Ein Team mit Geschichte</h2>
			<p>Los ging's 2007 mit einem USI-Sportkurs. Heute stehen bei uns Studierende und Berufstätige gemeinsam auf dem Feld. Wir trainieren, spielen in Tirol und reisen für Turniere durch Österreich. Du brauchst keine Erfahrung, um einzusteigen.</p>
			<a class="button" href={`${base}wer-wir-sind`}>Unser Team</a>
		</div>
		<img class="team-photo" src={`${base}images/team-huddle-2024.jpg`} alt="Die USI Avalanches im Teamhuddle auf dem Innsbrucker USI-Sportplatz" loading="lazy" />
	</section>

	<section class="home-section">
		<p class="eyebrow">Lern uns kennen</p>
		<h2>Lust auf Flag Football?</h2>
		<div class="tile-grid">
			<a class="home-tile" href={`${base}was-ist-flagfootball`}>
				<img src={`${base}images/flag-action-2024.jpeg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Was ist Flag Football?</h3>
			</a>
			<a class="home-tile" href={`${base}wer-wir-sind`}>
				<img src={`${base}images/team-photo-2023.jpeg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Unser Team</h3>
			</a>
			<a class="home-tile" href={`${base}kontakt`}>
				<img src={`${base}images/flag-action-2022.jpg`} alt="" aria-hidden="true" loading="lazy" />
				<span class="tile-shade" aria-hidden="true"></span>
				<h3>Komm zum Probetraining</h3>
			</a>
		</div>
	</section>

	<InstagramEmbed />
</IndexLayout>
